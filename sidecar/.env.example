# Copy to .env (git-ignored) and fill in.

# Must match SIDECAR_TOKEN in web/.env.
SIDECAR_TOKEN=

# Where the web app's API lives.
GROCERY_PLANNER_API_URL=http://localhost:8000/api

# Saved Instacart session, written by `npm run login` (git-ignored).
IC_STORAGE_STATE=./storage-state.json

# How often `npm run loop` asks the web app whether a stock check is due.
POLL_SECONDS=60
