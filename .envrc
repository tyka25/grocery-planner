# This repo uses the abbo2t GitHub account, not the tabbott_fareway token
# from the shell environment. Unsetting these lets `gh` fall back to its
# own stored login for abbo2t instead (run `gh auth login` once to store
# it — see project notes). Git push/pull auth is unaffected either way:
# origin uses the github-abbo2t SSH host alias directly.
unset GH_TOKEN
unset GITHUB_TOKEN
